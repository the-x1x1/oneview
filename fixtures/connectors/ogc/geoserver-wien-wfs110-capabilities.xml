      <ows:DCP>
        <ows:HTTP>
          <ows:Get xlink:href="http://data.wien.gv.at/daten/geo" />
          <ows:Post xlink:href="http://data.wien.gv.at/daten/geo" />
        </ows:HTTP>
      </ows:DCP>
      <ows:Parameter name="outputFormat">
        <ows:Value>text/xml; subtype=gml/3.1.1</ows:Value>
      </ows:Parameter>
    </ows:Operation>
    <ows:Operation name="GetFeature">
      <ows:DCP>
