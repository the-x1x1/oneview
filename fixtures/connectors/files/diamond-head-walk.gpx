<?xml version="1.0" encoding="UTF-8"?>
<!-- Invented in the published GPX 1.1 shape (https://www.topografix.com/GPX/1/1/): a walk
     up Diamond Head, Honolulu. Not a recording. The third waypoint's latitude is out of
     range on purpose. -->
