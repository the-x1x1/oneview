        <southBoundLatitude>-10.0</southBoundLatitude>
        <northBoundLatitude>70.0</northBoundLatitude>
      </EX_GeographicBoundingBox>
      <BoundingBox CRS="CRS:84" minx="-180.0" miny="-10.0" maxx="-10.0" maxy="70.0"/>
