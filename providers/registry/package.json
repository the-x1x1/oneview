{
  "name": "@worldview/providers",
  "version": "0.1.0",
  "private": true,
  "description": "Provider registry: factory maps of every WorldProvider shipped with WORLDVIEW (consumed by the runtime; never by UI or renderers).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@worldview/provider-adsb-remote": "workspace:*",
    "@worldview/provider-ais": "workspace:*",
    "@worldview/provider-cameras-local": "workspace:*",
    "@worldview/provider-cctv-public": "workspace:*",
    "@worldview/provider-celestrak": "workspace:*",
    "@worldview/provider-firms": "workspace:*",
    "@worldview/provider-infrastructure": "workspace:*",
    "@worldview/provider-nhc": "workspace:*",
    "@worldview/provider-readsb-local": "workspace:*",
    "@worldview/provider-sdk": "workspace:*",
    "@worldview/provider-usgs": "workspace:*",
    "@worldview/provider-weather": "workspace:*",
    "@worldview/provider-weatherlink-local": "workspace:*"
  },
  "sideEffects": false
}
