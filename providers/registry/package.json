{
  "name": "@worldview/providers",
  "version": "0.1.0",
  "private": true,
  "description": "Provider registry: factory map of every WorldProvider shipped with WORLDVIEW (consumed by the runtime; never by UI or renderers).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": { "typecheck": "tsc -p tsconfig.json" },
  "dependencies": {
    "@worldview/provider-sdk": "workspace:*",
    "@worldview/provider-usgs": "workspace:*",
    "@worldview/provider-celestrak": "workspace:*",
    "@worldview/provider-firms": "workspace:*",
    "@worldview/provider-weather": "workspace:*"
  },
  "sideEffects": false
}
