{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx",
    "packages/render-core/src/**/*.ts",
    "apps/desktop/src/renderer/**/*.ts",
    "apps/desktop/src/renderer/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
