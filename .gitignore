# agent worktrees
.claude/

# artifacts/ is generated output. Every one of these files is rewritten by the tool
# that produces it — `pnpm test`, `pnpm typecheck`, `pnpm boundary-check`,
# `pnpm provider:test`, `pnpm benchmark` — and each carries the timestamp of that run,
# so tracking them meant an ordinary gate run dirtied the repository and blocked pulls.
#
# Evidence that has to survive is snapshotted at release time into docs/releases/
# (verification-<version>.json and the SBOM), which is committed and reviewable.
# Anything under artifacts/ is reproduced by running the gate.
artifacts/

# Cesium's static assets, staged by scripts/cesium-assets.mjs for Vite's publicDir.
# Generated on every build from the installed cesium package; never committed.
apps/desktop/.vite-public/

# electron-builder's downloaded signing tools, seeded by apps/desktop/scripts/package.mjs.
apps/desktop/.electron-builder-cache/
