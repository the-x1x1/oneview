{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "providers/*/src/**/*.ts",
    "tools/*/src/**/*.ts",
    "apps/desktop/src/main/**/*.ts",
    "apps/desktop/src/preload/**/*.ts",
    "apps/desktop/src/shared/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "packages/ui/**",
    "apps/desktop/src/renderer/**"
  ]
}
