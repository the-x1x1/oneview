      "CHANGELOG.md",
      "README.md",
      "docs/adr/**",
      "docs/roadmap/PARALLEL-PHASES.md",
      "docs/roadmap/INTEGRATION.md",
      "docs/roadmap/phases/ownership.json",
      "docs/EXECUTION-STATUS.md",
      "docs/releases/**",
      "docs/security/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.base.json",
      "tsconfig.json",
      "tsconfig.renderer.json"
