{
  "schema": "oneview.connector.v1",
  "id": "eccc-radar-rain-wms",
  "name": "North American radar, rain rate (WMS)",
  "description": "MSC GeoMet's 1 km radar composite (precipitation rate for rain) as a raster overlay, at the time the operator picks or the latest.",
  "connector": "wms",
  "objectType": "place",
  "categories": ["weather"],
  "endpoint": {
    "url": "https://geo.weather.gc.ca/geomet",
    "query": {
      "version": "1.3.0",
      "layers": "RADAR_1KM_RRAI",
      "styles": "Radar-Rain_14colors",
      "format": "image/png",
      "transparent": true,
      "layer": "RADAR_1KM_RRAI"
    },
    "intervalSeconds": 600
  },
  "mapping": { "externalId": "id" },
  "attribution": {
    "text": "Data Source: Environment and Climate Change Canada",
    "url": "https://eccc-msc.github.io/open-data/licence/readme_en/"
  },
  "termsUrl": "https://eccc-msc.github.io/open-data/licence/readme_en/",
  "sourceQuality": "authoritative",
  "review": "user-configured",
  "enabled": false,
  "settings": [
    {
      "key": "time",
      "label": "Radar time",
      "description": "An ISO 8601 time within the last three hours (six-minute steps), or current. Unset: the service's latest.",
      "kind": "string",
      "defaultLabel": "Latest",
      "placeholder": "2026-09-24T02:30:00Z"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "kind": "number",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "defaultLabel": "Opaque"
    }
  ]
}
