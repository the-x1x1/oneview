{
  "schema": "oneview.connector.v1",
  "id": "gibs-goes-west-infrared",
  "name": "Satellite infrared, eastern Pacific (GOES-West, NASA GIBS)",
  "description": "Clean longwave infrared (10.3 µm, ABI band 13) from GOES-West, every 10 minutes day and night, rendered by NASA GIBS and drawn from the antimeridian to 106° W: cloud tops over the eastern and central Pacific and western North America, where eastern Pacific hurricanes form. Each poll republishes the newest frame, typically 20–40 minutes old.",
  "connector": "wmts",
  "objectType": "place",
  "categories": ["weather"],
  "endpoint": {
    "url": "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/wmts.cgi?LAYER=GOES-West_ABI_Band13_Clean_Infrared",
    "query": {
      "layer": "GOES-West_ABI_Band13_Clean_Infrared",
      "tileMatrixSet": "GoogleMapsCompatible_Level6",
      "format": "image/png",
      "time": "latest",
      "extent": "-180,-60,-106,60",
      "opacity": 0.85,
      "fadeBelow": "135,195",
      "role": "overlay"
    },
    "intervalSeconds": 600,
    "timeoutSeconds": 30
  },
  "mapping": {
    "externalId": "id"
  },
  "sourceQuality": "authoritative",
  "attribution": {
    "text": "Satellite: NOAA GOES-West via NASA GIBS (ESDIS)",
    "url": "https://www.earthdata.nasa.gov/engage/open-data-services-software/earthdata-developer-portal/gibs-api",
    "licenseId": "US-PD"
  },
  "termsUrl": "https://www.earthdata.nasa.gov/earth-observation-data/data-use-policy",
  "dataPolicy": {
    "cacheAllowed": true,
    "rawPayloadRetentionAllowed": true,
    "normalizedRetentionAllowed": true,
    "redistributionAllowed": true,
    "offlinePackAllowed": true,
    "exportAllowed": true,
    "commercialUseAllowed": true,
    "attributionRequired": true,
    "attributionText": "Satellite: NOAA GOES-West via NASA GIBS (ESDIS)",
    "termsUrl": "https://www.earthdata.nasa.gov/earth-observation-data/data-use-policy"
  },
  "review": "commercially-reviewed",
  "enabled": true,
  "settings": [
    {
      "key": "time",
      "label": "Frame time",
      "description": "latest (the default) follows the newest frame NASA GIBS lists; an ISO 8601 time within the frames it lists pins one.",
      "kind": "string",
      "defaultLabel": "Latest",
      "placeholder": "2026-09-28T15:50:00Z"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "kind": "number",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "defaultLabel": "55%"
    }
  ]
}
