{
  "schema": "oneview.connector.v1",
  "id": "nowcoast-goes-infrared",
  "name": "Satellite infrared, North America (NOAA nowCOAST GOES)",
  "description": "GOES-East and GOES-West Band 14 longwave infrared imagery (cloud and surface temperature patterns, about 2 km, updated every few minutes) from NOAA nowCOAST as a raster overlay over North America. Off by default: it covers the map beneath it; set Opacity to see through it.",
  "connector": "wms",
  "objectType": "place",
  "categories": ["weather"],
  "endpoint": {
    "url": "https://nowcoast.noaa.gov/geoserver/observations/satellite/wms",
    "query": {
      "version": "1.3.0",
      "layers": "goes_longwave_imagery",
      "styles": "goes-lir",
      "format": "image/png",
      "transparent": true,
      "time": "latest",
      "role": "overlay"
    },
    "intervalSeconds": 600,
    "timeoutSeconds": 20
  },
  "mapping": {
    "externalId": "id"
  },
  "sourceQuality": "authoritative",
  "attribution": {
    "text": "Satellite: NOAA nowCOAST, NESDIS GOES",
    "url": "https://nowcoast.noaa.gov/",
    "licenseId": "US-PD"
  },
  "termsUrl": "https://oceanservice.noaa.gov/disclaimer.html",
  "dataPolicy": {
    "cacheAllowed": true,
    "rawPayloadRetentionAllowed": true,
    "normalizedRetentionAllowed": true,
    "redistributionAllowed": true,
    "offlinePackAllowed": true,
    "exportAllowed": true,
    "commercialUseAllowed": true,
    "attributionRequired": false,
    "attributionText": "Satellite: NOAA nowCOAST, NESDIS GOES",
    "termsUrl": "https://oceanservice.noaa.gov/disclaimer.html"
  },
  "review": "commercially-reviewed",
  "enabled": false,
  "settings": [
    {
      "key": "time",
      "label": "Frame time",
      "description": "latest (the default) follows the newest frame the service lists; an ISO 8601 time within the frames it lists pins one; current asks for the service's own default.",
      "kind": "string",
      "defaultLabel": "Latest",
      "placeholder": "2026-09-27T21:36:00Z"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "kind": "number",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "defaultLabel": "Opaque"
    }
  ]
}
