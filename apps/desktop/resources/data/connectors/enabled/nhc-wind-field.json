{
  "schema": "oneview.connector.v1",
  "id": "nhc-wind-field",
  "name": "NHC wind field (active tropical cyclones)",
  "description": "How far from each active storm's centre its winds reach now, from the advisory: the areas of tropical-storm-force (34 kt), 50 kt and hurricane-force (64 kt) sustained wind, nested, with the radius in each quadrant. Replaced with each advisory. Empty when no storm is active.",
  "connector": "arcgis-feature",
  "objectType": "weather-alert",
  "categories": ["weather", "disasters"],
  "endpoint": {
    "url": "https://mapservices.weather.noaa.gov/tropical/rest/services/tropical/NHC_tropical_weather_summary/MapServer/16",
    "query": {
      "where": "ne > 0 OR se > 0 OR sw > 0 OR nw > 0",
      "outFields": "objectid,radii,stormid,basin,stormnum,advnum,validtime,synoptime,tau,ne,se,sw,nw,idp_source,idp_filedate,binnumber",
      "geometryPrecision": 2,
      "maxAllowableOffset": 0.02
    },
    "intervalSeconds": 900,
    "timeoutSeconds": 20
  },
  "mapping": {
    "externalId": { "concat": ["properties.stormid", "properties.tau", "properties.radii"] },
    "observedAt": {
      "path": "properties.idp_filedate",
      "transform": "isoTimestamp"
    },
    "position": {
      "geometry": "geometry"
    },
    "geometry": "geometry",
    "labels": {
      "name": "properties.stormid"
    },
    "properties": {
      "title": {
        "literal": "Wind field"
      },
      "event": {
        "literal": "NHC advisory wind field"
      },
      "cycloneLayer": {
        "literal": "wind-field"
      },
      "windRadiiKt": {
        "path": "properties.radii",
        "transform": "integer"
      },
      "radiusNeNm": {
        "path": "properties.ne",
        "transform": "number"
      },
      "radiusSeNm": {
        "path": "properties.se",
        "transform": "number"
      },
      "radiusSwNm": {
        "path": "properties.sw",
        "transform": "number"
      },
      "radiusNwNm": {
        "path": "properties.nw",
        "transform": "number"
      },
      "stormId": "properties.stormid",
      "basin": "properties.basin",
      "advisoryNumber": "properties.advnum",
      "binNumber": "properties.binnumber",
      "gisSource": "properties.idp_source",
      "detailUrl": {
        "literal": "https://www.nhc.noaa.gov/"
      },
      "senderName": {
        "literal": "NOAA National Hurricane Center"
      }
    }
  },
  "freshness": {
    "liveSeconds": 21600,
    "recentSeconds": 32400,
    "expireSeconds": 43200
  },
  "sourceQuality": "authoritative",
  "attribution": {
    "text": "Tropical cyclone forecasts: NOAA National Hurricane Center",
    "url": "https://www.nhc.noaa.gov/",
    "licenseId": "US-PD"
  },
  "termsUrl": "https://www.weather.gov/disclaimer",
  "dataPolicy": {
    "cacheAllowed": true,
    "rawPayloadRetentionAllowed": true,
    "normalizedRetentionAllowed": true,
    "redistributionAllowed": true,
    "offlinePackAllowed": true,
    "exportAllowed": true,
    "commercialUseAllowed": true,
    "attributionRequired": false,
    "attributionText": "Tropical cyclone forecasts: NOAA National Hurricane Center",
    "termsUrl": "https://www.weather.gov/disclaimer"
  },
  "review": "commercially-reviewed",
  "enabled": true
}
